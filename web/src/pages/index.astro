---
import appScreenshot from "../assets/atelier-app-screenshot.png";
import logo from "../assets/atelier-logo.png";
import { getAstroSiteConfig } from "../config/siteConfig.mjs";
import {
  getLandingPageAssetUrl,
  landingPageAssets,
  siteContent
} from "../siteContent";

const title = siteContent.productName;
const { base } = getAstroSiteConfig();
const faviconUrl = getLandingPageAssetUrl("favicon", base);
const manifestUrl = getLandingPageAssetUrl("manifest", base);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="application-name" content={title} />
    <meta name="theme-color" content="#201f1c" />
    <link rel="icon" type="image/png" href={faviconUrl} />
    <link rel="manifest" href={manifestUrl} />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <img class="logo" src={logo.src} width="72" height="72" alt={landingPageAssets.logo.alt} />
      <h1>{title}</h1>
      <p>Landing page foundation.</p>
      <img
        class="screenshot"
        src={appScreenshot.src}
        width={appScreenshot.width}
        height={appScreenshot.height}
        alt={landingPageAssets.screenshot.alt}
        loading="eager"
        decoding="async"
      />
    </main>
  </body>
</html>

<style>
  :global(html) {
    background: #f7f4ef;
    color: #201f1c;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  :global(body) {
    min-height: 100vh;
    margin: 0;
  }

  main {
    min-height: calc(100vh - 4rem);
    display: grid;
    justify-items: center;
    align-content: center;
    padding: 2rem;
    text-align: center;
  }

  .logo {
    display: block;
    margin: 0 0 1rem;
    border-radius: 1rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 12vw, 5rem);
    line-height: 1;
  }

  p {
    margin: 1rem 0 0;
    color: #5b554a;
    font-size: 1rem;
  }

  .screenshot {
    display: block;
    width: min(100%, 56rem);
    height: auto;
    margin-top: 2rem;
    border: 1px solid rgb(32 31 28 / 14%);
    border-radius: 0.5rem;
    box-shadow: 0 1rem 3rem rgb(32 31 28 / 14%);
  }
</style>
