---
const title = "Atelier";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <h1>{title}</h1>
      <p>Landing page foundation.</p>
    </main>
  </body>
</html>

<style>
  :global(html) {
    background: #f7f4ef;
    color: #201f1c;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  :global(body) {
    min-height: 100vh;
    margin: 0;
  }

  main {
    min-height: 100vh;
    display: grid;
    place-content: center;
    padding: 2rem;
    text-align: center;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 12vw, 5rem);
    line-height: 1;
  }

  p {
    margin: 1rem 0 0;
    color: #5b554a;
    font-size: 1rem;
  }
</style>
