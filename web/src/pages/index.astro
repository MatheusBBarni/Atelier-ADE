---
import focusAndAppearanceScreenshot from "../assets/atelier-app-focus-and-appearance.png";
import focusWorkspaceScreenshot from "../assets/atelier-app-focus-workspace.png";
import appScreenshot from "../assets/atelier-app-screenshot.png";
import settingsAgentProfilesScreenshot from "../assets/atelier-app-settings-agent-profiles.png";
import settingsKeyboardShortcutsScreenshot from "../assets/atelier-app-settings-keyboard-shortcuts.png";
import logo from "../assets/atelier-logo.png";
import RepoStarCTA from "../components/RepoStarCTA.astro";
import { getAstroSiteConfig } from "../config/siteConfig.mjs";
import {
  getLandingPageAssetUrl,
  getOrderedCtas,
  getPrimaryCta,
  getSecondaryEvaluationLinks,
  landingPageAssets,
  siteContent,
  withSiteBase
} from "../siteContent";

const { base } = getAstroSiteConfig();
const faviconUrl = getLandingPageAssetUrl("favicon", base);
const manifestUrl = getLandingPageAssetUrl("manifest", base);
const homeUrl = withSiteBase("/", base);
const orderedCtas = getOrderedCtas();
const primaryCta = getPrimaryCta();
const secondaryCtas = getSecondaryEvaluationLinks();
const pageTitle = `${siteContent.productName} | Native macOS agent workspace`;
const productSurfaceImages = {
  focusAndAppearance: focusAndAppearanceScreenshot,
  focusWorkspace: focusWorkspaceScreenshot,
  settingsAgentProfiles: settingsAgentProfilesScreenshot,
  settingsKeyboardShortcuts: settingsKeyboardShortcutsScreenshot
} as const;
const productSurfaces = siteContent.productSurfaces.items.map((surface) => ({
  ...surface,
  asset: landingPageAssets[surface.assetKey],
  image: productSurfaceImages[surface.assetKey]
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={siteContent.metaDescription} />
    <meta name="generator" content={Astro.generator} />
    <meta name="application-name" content={siteContent.productName} />
    <meta name="theme-color" content="#1e2620" />
    <link rel="icon" type="image/png" href={faviconUrl} />
    <link rel="manifest" href={manifestUrl} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header" aria-label="Site navigation">
      <a class="brand" href={homeUrl} aria-label={`${siteContent.productName} home`}>
        <img src={logo.src} width="36" height="36" alt="" aria-hidden="true" />
        <span>{siteContent.productName}</span>
      </a>
      <nav aria-label="Landing page sections">
        <a href="#proof">Proof</a>
        <a href="#surfaces">Surfaces</a>
        <a href="#capabilities">Capabilities</a>
        <a href="#evaluate">Evaluate</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-backdrop" aria-hidden="true"></div>
        <div class="hero-inner">
          <div class="hero-copy">
            <p class="eyebrow">{siteContent.hero.eyebrow}</p>
            <h1 id="hero-title">{siteContent.hero.title}</h1>
            <p class="hero-summary">{siteContent.hero.summary}</p>

            <ul class="hero-bullets" aria-label="Atelier principles">
              {siteContent.hero.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>

            <div class="hero-actions" aria-label="Primary evaluation paths">
              {primaryCta && <RepoStarCTA cta={primaryCta} />}
              <div class="secondary-actions">
                {
                  secondaryCtas.map((link) => (
                    <a class="button button-secondary" href={link.href} aria-label={link.ariaLabel}>
                      {link.label}
                    </a>
                  ))
                }
              </div>
            </div>

            <p class="status-note">{siteContent.statusNote}</p>
          </div>

          <figure class="hero-product" aria-label="Current Atelier app interface">
            <div class="screenshot-frame hero-screenshot">
              <div class="screenshot-label" aria-hidden="true">
                <span>Current build</span>
                <span>macOS workspace</span>
              </div>
              <img
                src={appScreenshot.src}
                width={appScreenshot.width}
                height={appScreenshot.height}
                alt=""
                loading="eager"
                decoding="async"
              />
            </div>
            <figcaption>
              Actual app surface: project sidebar, session state, terminal space, and file context.
            </figcaption>
          </figure>
        </div>
      </section>

      <section class="proof-section" id="proof" aria-labelledby="proof-title">
        <div class="section-inner proof-grid">
          <div class="proof-copy">
            <p class="eyebrow">{siteContent.proof.eyebrow}</p>
            <h2 id="proof-title">{siteContent.proof.title}</h2>
            <p>{siteContent.proof.description}</p>
          </div>
          <figure class="product-proof">
            <div class="screenshot-frame proof-screenshot">
              <div class="screenshot-label" aria-hidden="true">
                <span>Product proof</span>
                <span>Current interface</span>
              </div>
              <img
                src={appScreenshot.src}
                width={appScreenshot.width}
                height={appScreenshot.height}
                alt={landingPageAssets.screenshot.alt}
                loading="eager"
                decoding="async"
              />
            </div>
            <figcaption>{siteContent.proof.caption}</figcaption>
          </figure>
        </div>
      </section>

      <section class="surfaces-section" id="surfaces" aria-labelledby="surfaces-title">
        <div class="section-inner">
          <div class="surface-heading">
            <div>
              <p class="eyebrow">{siteContent.productSurfaces.eyebrow}</p>
              <h2 id="surfaces-title">{siteContent.productSurfaces.title}</h2>
            </div>
            <p>{siteContent.productSurfaces.description}</p>
          </div>

          <div class="surface-gallery" aria-label="Additional Atelier app screenshots">
            {
              productSurfaces.map((surface) => (
                <article class="surface-card">
                  <div class="surface-card-copy">
                    <p class="eyebrow">{surface.eyebrow}</p>
                    <h3>{surface.title}</h3>
                    <p>{surface.description}</p>
                  </div>
                  <div class="screenshot-frame surface-screenshot">
                    <div class="screenshot-label" aria-hidden="true">
                      <span>{surface.title}</span>
                      <span>Current app</span>
                    </div>
                    <img
                      src={surface.image.src}
                      width={surface.image.width}
                      height={surface.image.height}
                      alt={surface.asset.alt}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="trust-section" aria-labelledby="trust-title">
        <div class="section-inner">
          <div class="section-heading">
            <p class="eyebrow">Trust posture</p>
            <h2 id="trust-title">Built for direct inspection.</h2>
          </div>
          <div class="trust-list">
            {
              siteContent.trustNotes.map((note) => (
                <article class="trust-note">
                  <h3>{note.title}</h3>
                  <p>{note.description}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="capabilities-section" id="capabilities" aria-labelledby="capabilities-title">
        <div class="section-inner">
          <div class="section-heading compact">
            <p class="eyebrow">What it does today</p>
            <h2 id="capabilities-title">Concrete workflow support, not broad promises.</h2>
          </div>
          <div class="capability-grid">
            {
              siteContent.capabilities.map((capability) => (
                <article class={`capability-card priority-${capability.priority}`}>
                  <span class="priority-label">{capability.priority}</span>
                  <h3>{capability.title}</h3>
                  <p>{capability.description}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="evaluation-section" id="evaluate" aria-labelledby="evaluate-title">
        <div class="section-inner evaluation-grid">
          <div>
            <p class="eyebrow">Next step</p>
            <h2 id="evaluate-title">Evaluate the project where the facts are visible.</h2>
          </div>
          <div class="evaluation-links" aria-label="Ordered evaluation links">
            {
              orderedCtas.map((link) => (
                <a
                  class={`evaluation-link evaluation-link-${link.priority}`}
                  href={link.href}
                  aria-label={link.ariaLabel}
                  data-cta-kind={link.kind}
                >
                  <span>{link.label}</span>
                  <small>{link.description}</small>
                </a>
              ))
            }
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <p>{siteContent.productName} is an early macOS project with public source for inspection.</p>
      <a href={siteContent.repoUrl}>Source on GitHub</a>
    </footer>
  </body>
</html>

<style>
  :global(:root) {
    color-scheme: light;
    --ink: #171916;
    --deep: #1e2620;
    --paper: #f7f8f3;
    --surface: #fffef9;
    --line: rgb(23 25 22 / 14%);
    --muted: #5d625a;
    --moss: #516b52;
    --rust: #a4553f;
    --blue: #335d7a;
    --gold: #b7802f;
    --screen: #20222b;
    --screen-line: rgb(255 255 255 / 14%);
    --shadow: 0 1.5rem 4rem rgb(23 25 22 / 14%);
    font-family:
      "Avenir Next", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
  }

  :global(html) {
    background: var(--paper);
    color: var(--ink);
    scroll-behavior: smooth;
  }

  :global(body) {
    min-height: 100vh;
    margin: 0;
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(a) {
    color: inherit;
  }

  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 20;
    transform: translateY(-160%);
    background: var(--deep);
    color: white;
    padding: 0.75rem 1rem;
    border-radius: 0.25rem;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.75rem;
    padding: 0.875rem max(1.25rem, calc((100vw - 72rem) / 2));
    border-bottom: 1px solid var(--line);
    background: rgb(247 248 243 / 88%);
    backdrop-filter: blur(18px);
  }

  .brand,
  .site-header nav,
  .hero-actions,
  .secondary-actions {
    display: flex;
    align-items: center;
  }

  .brand {
    gap: 0.75rem;
    text-decoration: none;
    font-weight: 700;
  }

  .brand img {
    display: block;
    border-radius: 0.5rem;
  }

  .site-header nav {
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 1rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .site-header nav a {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .site-header nav a:hover {
    color: var(--ink);
  }

  .hero {
    position: relative;
    min-height: 82svh;
    display: grid;
    align-items: center;
    isolation: isolate;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(circle at 82% 24%, rgb(81 107 82 / 14%), transparent 32rem),
      linear-gradient(135deg, #fbfbf5 0%, var(--paper) 48%, #edf1e8 100%),
      var(--paper);
  }

  .hero-backdrop {
    position: absolute;
    inset: auto 0 0;
    z-index: -1;
    height: 42%;
    border-top: 1px solid var(--line);
    background:
      linear-gradient(90deg, rgb(81 107 82 / 10%), rgb(164 85 63 / 7%), rgb(51 93 122 / 10%)),
      repeating-linear-gradient(
        90deg,
        rgb(23 25 22 / 6%) 0,
        rgb(23 25 22 / 6%) 1px,
        transparent 1px,
        transparent 4rem
      );
  }

  .hero-inner,
  .section-inner {
    width: min(72rem, calc(100% - 2.5rem));
    margin: 0 auto;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(24rem, 1.12fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding: 5rem 0;
  }

  .hero-copy {
    max-width: 43rem;
  }

  .eyebrow,
  .priority-label {
    margin: 0;
    color: var(--rust);
    font-size: 0.78rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1,
  h2 {
    font-family: "Iowan Old Style", "Palatino Linotype", Palatino, ui-serif, Georgia, serif;
    font-weight: 700;
    letter-spacing: 0;
  }

  h1 {
    max-width: 13ch;
    margin-bottom: 1.15rem;
    font-size: 5rem;
    line-height: 0.96;
  }

  h2 {
    margin-bottom: 1rem;
    font-size: 2.75rem;
    line-height: 1.05;
  }

  h3 {
    margin-bottom: 0.65rem;
    font-size: 1.05rem;
    line-height: 1.25;
  }

  .hero-summary {
    max-width: 39rem;
    margin-bottom: 1.5rem;
    color: #343831;
    font-size: 1.35rem;
    line-height: 1.5;
  }

  .hero-bullets {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.65rem;
    max-width: 38rem;
    margin: 0 0 2rem;
    padding: 0;
    list-style: none;
  }

  .hero-bullets li {
    min-height: auto;
    display: flex;
    align-items: center;
    padding: 0.85rem 1rem;
    border: 1px solid var(--line);
    border-left: 3px solid var(--moss);
    border-radius: 0.45rem;
    background: rgb(255 254 249 / 84%);
    color: #2f342f;
    font-weight: 650;
  }

  .hero-bullets li:nth-child(2) {
    border-left-color: var(--blue);
  }

  .hero-bullets li:nth-child(3) {
    border-left-color: var(--rust);
  }

  .hero-actions {
    flex-wrap: wrap;
    gap: 1rem;
  }

  .repo-cta-slot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
  }

  .repo-cta-slot p {
    max-width: 25rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.4;
  }

  .secondary-actions {
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .button,
  .evaluation-link {
    min-height: 3rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    border-radius: 0.375rem;
    text-decoration: none;
    font-weight: 750;
  }

  .button {
    padding: 0.85rem 1.1rem;
  }

  .button-primary {
    background: var(--deep);
    color: white;
    box-shadow: 0 0.85rem 1.75rem rgb(30 38 32 / 18%);
  }

  .button-primary:hover {
    background: #2b382f;
  }

  .button-secondary {
    border-color: var(--line);
    background: rgb(255 254 249 / 82%);
    color: #283029;
  }

  .button-secondary:hover {
    border-color: rgb(51 93 122 / 42%);
    color: var(--blue);
  }

  .status-note {
    margin: 1.35rem 0 0;
    color: var(--muted);
    font-weight: 700;
  }

  .hero-product {
    position: relative;
    isolation: isolate;
    margin: 0;
  }

  .hero-product::before {
    content: "";
    position: absolute;
    inset: 2.25rem -1.15rem -1.35rem 1.15rem;
    z-index: -1;
    border: 1px solid rgb(81 107 82 / 24%);
    border-radius: 1.2rem;
    background: #e6ebe1;
  }

  .screenshot-frame {
    overflow: hidden;
    padding: 0.65rem;
    border: 1px solid rgb(23 25 22 / 24%);
    border-radius: 1.1rem;
    background: var(--screen);
    box-shadow: 0 2rem 5rem rgb(23 25 22 / 24%);
  }

  .screenshot-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.25rem 0.35rem 0.65rem;
    color: rgb(255 254 249 / 74%);
    font-size: 0.72rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .screenshot-label span:first-child {
    color: #f2bd81;
  }

  .screenshot-frame img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--screen-line);
    border-radius: 0.72rem;
  }

  .hero-product figcaption {
    max-width: 38rem;
  }

  .hero-product figcaption,
  .product-proof figcaption {
    margin-top: 0.9rem;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .proof-section,
  .surfaces-section,
  .trust-section,
  .capabilities-section,
  .evaluation-section {
    padding: 5.5rem 0;
  }

  .proof-section {
    background: linear-gradient(180deg, var(--surface), #f1f3ea);
  }

  .proof-grid,
  .evaluation-grid {
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    gap: 3rem;
    align-items: center;
  }

  .proof-copy p:not(.eyebrow),
  .section-heading p,
  .site-footer p {
    color: var(--muted);
    line-height: 1.7;
  }

  .product-proof {
    margin: 0;
  }

  .product-proof .screenshot-frame {
    box-shadow: var(--shadow);
  }

  .surfaces-section {
    position: relative;
    overflow: hidden;
    border-block: 1px solid var(--line);
    background:
      radial-gradient(circle at 16% 14%, rgb(183 128 47 / 16%), transparent 24rem),
      radial-gradient(circle at 88% 82%, rgb(51 93 122 / 14%), transparent 26rem),
      linear-gradient(180deg, #f6f1df 0%, #f2efe6 100%);
  }

  .surfaces-section::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgb(23 25 22 / 5%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(23 25 22 / 5%) 1px, transparent 1px);
    background-size: 3.25rem 3.25rem;
    mask-image: linear-gradient(180deg, transparent, black 18%, black 82%, transparent);
  }

  .surfaces-section .section-inner {
    position: relative;
    z-index: 1;
  }

  .surface-heading {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(18rem, 0.75fr);
    gap: clamp(1.25rem, 4vw, 4rem);
    align-items: end;
    margin-bottom: 2rem;
  }

  .surface-heading h2 {
    margin-bottom: 0;
  }

  .surface-heading > p {
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .surface-gallery {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1.1rem;
    align-items: start;
  }

  .surface-card {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: 1rem;
    padding: 1rem;
    border: 1px solid rgb(23 25 22 / 16%);
    border-radius: 0.85rem;
    background: rgb(255 254 249 / 86%);
    box-shadow: 0 1.25rem 3rem rgb(23 25 22 / 12%);
  }

  .surface-card:nth-child(1) {
    grid-column: span 7;
  }

  .surface-card:nth-child(2) {
    grid-column: span 5;
    margin-top: 2.25rem;
  }

  .surface-card:nth-child(3) {
    grid-column: span 5;
  }

  .surface-card:nth-child(4) {
    grid-column: span 7;
    margin-top: -1.15rem;
  }

  .surface-card::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 0.28rem;
    background: var(--moss);
  }

  .surface-card:nth-child(2)::before {
    background: var(--blue);
  }

  .surface-card:nth-child(3)::before {
    background: var(--rust);
  }

  .surface-card:nth-child(4)::before {
    background: var(--gold);
  }

  .surface-card-copy {
    padding: 0.35rem 0.25rem 0;
  }

  .surface-card h3 {
    font-size: 1.18rem;
  }

  .surface-card-copy p:not(.eyebrow) {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
  }

  .surface-screenshot {
    padding: 0.5rem;
    border-radius: 0.85rem;
    background: #20222b;
    box-shadow: none;
  }

  .surface-screenshot .screenshot-label {
    padding: 0.18rem 0.25rem 0.5rem;
    font-size: 0.62rem;
  }

  .surface-screenshot img {
    border-radius: 0.55rem;
  }

  .trust-section {
    background: #ebf0e7;
  }

  .section-heading {
    max-width: 42rem;
    margin-bottom: 2rem;
  }

  .section-heading.compact {
    max-width: 48rem;
  }

  .trust-list,
  .capability-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .trust-note,
  .capability-card {
    min-height: 11rem;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    background: var(--surface);
  }

  .trust-note {
    padding: 1.25rem;
  }

  .trust-note p,
  .capability-card p,
  .evaluation-link small {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
  }

  .capabilities-section {
    background: var(--paper);
  }

  .capability-grid {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  .capability-card {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: 1rem;
  }

  .priority-critical {
    border-top: 4px solid var(--moss);
  }

  .priority-high {
    border-top: 4px solid var(--blue);
  }

  .priority-medium {
    border-top: 4px solid var(--gold);
  }

  .evaluation-section {
    background: var(--deep);
    color: white;
  }

  .evaluation-section .eyebrow {
    color: #f2bd81;
  }

  .evaluation-section h2 {
    margin-bottom: 0;
  }

  .evaluation-links {
    display: grid;
    gap: 0.8rem;
  }

  .evaluation-link {
    min-height: 5.75rem;
    display: grid;
    justify-content: stretch;
    gap: 0.35rem;
    padding: 1rem 1.1rem;
    border-color: rgb(255 255 255 / 18%);
    background: rgb(255 255 255 / 8%);
  }

